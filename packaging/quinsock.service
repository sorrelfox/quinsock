[Unit]
Description=quinsock SOCKS5 proxy server
Documentation=file:///usr/share/doc/quinsock/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=quinsock
Group=quinsock
ExecStart=/usr/bin/quinsock --config /etc/quinsock/config.toml
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
# Longer than server.shutdown_grace_secs (default 10) so connections can drain.
TimeoutStopSec=30
LimitNOFILE=1048576

# Hardening. The server only needs to open network sockets and read its config.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# To listen on a port below 1024, or to use outbound.interface (SO_BINDTODEVICE),
# run `systemctl edit quinsock` and add:
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
